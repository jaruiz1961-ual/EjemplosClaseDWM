@page "/seguridad/roles"
@namespace BlazorSeguridad2026.Base.Seguridad

@using BlazorSeguridad2026.Base.Genericos
@using BlazorSeguridad2026.Base.Modelo
@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

@inject IRoleService RoleServiceMio
@inject NavigationManager Nav
@inject IContextProvider ContextProvider
@inject IUnitOfWorkFactory UnitOfWorkFactory
@inject RoleManager<ApplicationRole> RoleManager
@inject DialogService DialogService
@inject ToastServiceMio ToastService


<h3>Roles</h3>
<ComponenteToast />

@if (!_isValidContext)
{
    <Alert Color="Color.Warning">
        Contexto inválido. Selecciona Tenant y DbKey.
    </Alert>
}
else
{
    <Table TItem="ApplicationRole"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           IsStriped="true"
           IsBordered="true"
           IsMultipleSelect="true"
           ShowToolbar="true"
           ShowExtendButtons="true"
           ShowLoading="true"
           ShowSearch="true"
           OnAddAsync="OnAddAsync"
           OnEditAsync="OnEditAsync"
           OnSaveAsync="OnSaveAsync"
           OnDeleteAsync="OnDeleteAsync"
           OnQueryAsync="OnQueryAsync" ,
           ColumnButtonTemplateHeaderText="Acciones"
           IsExtendButtonsInRowHeader="false">

        <TableColumns>
            <TableColumn @bind-Field="context.Name" Text="Nombre" />
            <TableColumn @bind-Field="context.TenantId" Text="TenantId" />
            <TableColumn @bind-Field="context.DbKey" Text="DbKey" />
        </TableColumns>

        <RowButtonTemplate Context="item">
            <TableCellButton Color="Color.Warning"
                             Size="Size.Small"
                             class="me-1"
                             OnClick="@(() => OpenRoleUsersDialogAsync(item))">
                Usuarios
            </TableCellButton>

        </RowButtonTemplate>

    </Table>



}

@code {

    private static IEnumerable<int> PageItemsSource => new[] { 4, 10, 20 };

    private List<ApplicationRole> Items { get; set; } = new();
    private bool _isValidContext;

    private string? error;
    private string? success;

    string fromUrl => Nav.ToBaseRelativePath(Nav.Uri);

    static int? TenantId;
    static string DbKey;

    private Action? _onContextChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        _onContextChangedHandler = async () => await LoadRolesAsync();
        ContextProvider.OnContextChanged += _onContextChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            if (!ContextProvider.IsValidState(StorageKeys.ServerState))
            {
                _isValidContext = false;
                StateHasChanged();
                return;
            }

            await ContextProvider.ReadStates();
            var cp = ContextProvider.CopyContext();

            DbKey = cp.States[(int)StorageKeys.ServerState].DbKey ?? string.Empty;
            TenantId = cp.States[(int)StorageKeys.ServerState].TenantId;

            var roleService = new RoleServiceMio(RoleManager, cp, UnitOfWorkFactory);
            var list = await roleService.GetAllAsync();

            Items = list?.ToList() ?? new();
            _isValidContext = true;

            StateHasChanged();
        }
        catch
        {
            _isValidContext = false;
            throw;
        }
    }

    // ---- Usuarios del rol (componente RolUsers en modal) ----
    private async Task OpenRoleUsersDialogAsync(ApplicationRole role)
    {
        var option = new DialogOption
        {
            Title = $"Usuarios del rol {role.Name}",
            Size = Size.Large,
            IsScrolling = true,
            ShowCloseButton = true,
            BodyTemplate = builder =>
            {
                builder.OpenComponent(0, typeof(ComponenteRolUsers));
                builder.AddAttribute(1, "Role", role);
                builder.AddAttribute(2, "From", Nav.Uri);
                builder.CloseComponent();
            }
        };

        await DialogService.Show(option);
        await Task.CompletedTask;
    }

    private static Task<ApplicationRole> OnAddAsync()
    => Task.FromResult(new ApplicationRole() { TenantId = TenantId, DbKey = DbKey });

    private static Task<ApplicationRole> OnEditAsync(ApplicationRole item)
        => Task.FromResult(item);

    @inject ToastServiceMio ToastService

    private async Task<bool> OnSaveAsync(ApplicationRole item, ItemChangedType changedType)
    {
        error = success = null;

        if (changedType == ItemChangedType.Add)
        {
            if (string.IsNullOrWhiteSpace(item.Name))
            {
                error = "Name es obligatorio.";
                ToastService.ShowError(error);
                return false;
            }

            var result = await RoleServiceMio.CreateAsync(
                item.Name,
                item.TenantId,
                item.DbKey);

            if (!result.Succeeded)
            {
                error = string.Join(" ", result.Errors.Select(e => e.Description));
                ToastService.ShowError(error);
                return false;
            }

            success = "Registro creado correctamente.";
            ToastService.ShowSuccess(success);
            return true;
        }
        else
        {
            var result = await RoleServiceMio.UpdateRoleAsync(
                item.Id,
                x =>
                {
                    x.Name = item.Name;
                    x.TenantId = item.TenantId ?? 0;
                    x.DbKey = item.DbKey;
                });

            if (!result.Succeeded)
            {
                error = string.Join(" ", result.Errors.Select(e => e.Description));
                ToastService.ShowError(error);
                return false;
            }

            success = "Registro actualizado correctamente.";
            ToastService.ShowSuccess(success);
            return true;
        }
    }


    

    private async Task<bool> OnDeleteAsync(IEnumerable<ApplicationRole> items)
    {
        error = success = null;

        foreach (var r in items)
        {
            var result = await RoleServiceMio.DeleteAsync(r.Id);
            if (!result.Succeeded)
            {
                error = string.Join(" ", result.Errors.Select(e => e.Description));
                return false;
            }
        }

        await LoadRolesAsync();
        success = "Rol(es) borrado(s).";
        return true;
    }

    // ------- Data loading del Table -------
    private async Task<QueryData<ApplicationRole>> OnQueryAsync(QueryPageOptions options)
    {
        await LoadRolesAsync();
        
        IEnumerable<ApplicationRole> data = Items ?? new List<ApplicationRole>();

        var isSearch = false;

        if (!string.IsNullOrEmpty(options.SearchText))
        {
            var text = options.SearchText;
            data = data.Where(u =>
                (!string.IsNullOrEmpty(u.Name) && u.Name.Contains(text, StringComparison.OrdinalIgnoreCase)));
            isSearch = true;
        }

        var total = data.Count();

        data = data
            .Skip((options.PageIndex - 1) * options.PageItems)
            .Take(options.PageItems)
            .ToList();

        var result = new QueryData<ApplicationRole>
        {
            Items = data,
            TotalCount = total,
            IsSorted = false,
            IsFiltered = false,
            IsSearch = isSearch
        };

        return await Task.FromResult(result);
    }

    private void Dispose()
        => ContextProvider.OnContextChanged -= _onContextChangedHandler;
}
