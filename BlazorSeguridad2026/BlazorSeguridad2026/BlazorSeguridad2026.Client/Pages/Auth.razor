@page "/auth"


@using BlazorSeguridad2026.Base.Modelo
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity

@attribute [Authorize]
@rendermode InteractiveAuto
@inject RoleManager<ApplicationRole> RoleManager

<PageTitle>Auth en cliente</PageTitle>

<h1>You are authenticated in Cliente App</h1>

<AuthorizeView>

        Debug: Rol Admin? @context.User.IsInRole("Admin")<br />
        Claims: @string.Join(", ", context.User.Claims.Select(c => $"{c.Type}={c.Value}"))

</AuthorizeView>
