@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject IContextProvider ContextProvider
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@functions {
    string GetAntiforgeryToken()
    {
        var http = HttpContextAccessor.HttpContext!;
        var tokens = Antiforgery.GetAndStoreTokens(http);
        return tokens.RequestToken!;
    }
}

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BlazorSeguridad2026</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3">
            <div class="nav-link" @onclick="ToggleAdminMenu">
                <span class="oi oi-lock-locked" aria-hidden="true"></span>
                Administración
            </div>

            @if (adminMenuExpanded)
            {
                <div class="nav-item px-4">
                    <!-- Páginas servidor -->
                    <div class="nav-link" @onclick="IrUsuariosServidor">
                        <span class="oi oi-people" aria-hidden="true"></span>
                        Usuarios
                    </div>

                    <div class="nav-link" @onclick="IrRolesServidor">
                        <span class="oi oi-key" aria-hidden="true"></span>
                        Roles
                    </div>

                    <div class="d-flex flex-column gap-2 mt-2">
                        <div class="d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm w-auto" @bind="SelectedDbKey">
                                @foreach (var opcion in ContextProvider.GetContextDbKeys())
                                {
                                    <option value="@opcion">@opcion</option>
                                }
                            </select>

                            <select class="form-select form-select-sm w-auto" @bind="SelectedTenantId">
                                @foreach (var opcion in ContextProvider.GetTenantIds())
                                {
                                    <option value="@opcion">@opcion</option>
                                }
                            </select>
                        </div>

                        <div>
                            <button type="button"
                                    class="btn btn-primary btn-sm"
                                    @onclick="Actualizar">
                                Actualizar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@if (!esPaginaCliente)
{
    <CultureSelector></CultureSelector>
}

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>

        <!-- Página servidor: ListaUsuarios -->
        <div class="nav-item px-3">
            <div class="nav-link" @onclick="IrListaUsuariosServidor">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Lista Usuarios
            </div>
        </div>

        <!-- Página cliente (WASM) -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ListaUsuariosCliente">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Lista U(Api)
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="auth">
                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Auth Required
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Logout">
                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Salir
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool adminMenuExpanded = false;
    private int? SelectedTenantId;
    private string? SelectedDbKey;
    private bool esPaginaCliente = false;
    private bool _reloading; // NUEVO

    private void ToggleAdminMenu()
        => adminMenuExpanded = !adminMenuExpanded;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await CalcularPaginaCliente();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CalcularPaginaCliente();

            var estado = ContextProvider.GetState();
            if (estado != null)
            {
                SelectedTenantId = estado.TenantId;
                SelectedDbKey = estado.DbKey;
            }

            // >>> AQUÍ USAMOS LastMode <<<
            if (!_reloading)
            {
                var lastMode = ContextProvider.GetLastMode();

                if (string.Equals(lastMode, "Cliente", StringComparison.OrdinalIgnoreCase))
                {
                    _reloading = true;

                    // Ya estamos en servidor, dejamos el modo en Server
                    ContextProvider.SetLastMode("Server");
                    await ContextProvider.SaveStates();

                    // Forzamos recarga SOLO esta primera vez
                    NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
                }
            }
        }
    }

    private async Task CalcularPaginaCliente()
    {
        await ContextProvider.ReadStates();
        esPaginaCliente =
            (ContextProvider.GetValor(ClavesEstado.EsPaginaCliente, StorageKeys.ServerState) ?? "false") == "true";
    }

    private async Task Actualizar()
    {
        await ContextProvider.UpdateTenantDbkey(SelectedTenantId, SelectedDbKey ?? "SqlServer", save: true);
        // Recarga la página actual con el nuevo contexto
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    // Navegación a páginas servidor con forceLoad explícito en clicks de menú
    private void IrUsuariosServidor()
        => NavigationManager.NavigateTo("/seguridad/users", forceLoad: true);

    private void IrRolesServidor()
        => NavigationManager.NavigateTo("/seguridad/roles", forceLoad: true);

    private void IrListaUsuariosServidor()
        => NavigationManager.NavigateTo("/ListaUsuarios", forceLoad: true);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
