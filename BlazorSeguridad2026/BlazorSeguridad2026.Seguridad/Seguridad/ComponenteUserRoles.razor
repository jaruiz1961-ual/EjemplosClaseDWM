@* //se llama como un componente desde una ventana modal en el componente Users ! *@

@namespace BlazorSeguridad2026.Base.Seguridad

@using BibliotecaContextosDb.Resources
@using Microsoft.AspNetCore.Identity
@using BlazorSeguridad2026.Base.Modelo

@using BootstrapBlazor.Components

@inject IUserService UserServiceMio
@inject RoleManager<ApplicationRole> RoleManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<h3>Asignar roles al usuario</h3>

@if (!string.IsNullOrEmpty(error))
{
    <Alert Color="Color.Danger">@error</Alert>
}
@if (!string.IsNullOrEmpty(success))
{
    <Alert Color="Color.Success">@success</Alert>
}

@if (isLoading)
{
    <p>Cargando...</p>
}
else if (user is null)
{
    <Alert Color="Color.Warning">Usuario no encontrado.</Alert>
}
else
{
    <Card Color="Color.Primary" IsCenter="true" Class="mb-3">
        <HeaderTemplate>
            Usuario
        </HeaderTemplate>

        <BodyTemplate>
            <p class="mb-1"><strong>Usuario:</strong> @user.Email</p>
            <p class="mb-0 text-muted"><strong>Id:</strong> @user.Id</p>
            <p class="mb-0 text-muted"><strong>TenantId:</strong> @user.TenantId</p>
            <p class="mb-0 text-muted"><strong>DbKey:</strong> @user.DbKey</p>
        </BodyTemplate>
    </Card>

    <h4>Roles</h4>

    @if (!RoleItems.Any())
    {
        <p>No hay roles definidos.</p>
    }
    else
    {
        <CheckboxList TValue="IEnumerable<string>"
                      Items="RoleItems"
                      @bind-Value="SelectedRoleNames">
            <ItemTemplate>
                @if (context is RoleSelectedItem roleItem)
                {
                    @if (!string.IsNullOrEmpty(roleItem.Icon))
                    {
                        <i class="@roleItem.Icon me-1"></i>
                    }
                    <span>@roleItem.Text</span>
                }
                else
                {
                    <span>@context.Text</span>
                }
            </ItemTemplate>
        </CheckboxList>

        <div class="mt-3">
            <Button Color="Color.Primary" Class="me-2" OnClick="SaveRoles">
                Guardar roles
            </Button>
        </div>
    }
}

@code {
    [Parameter, EditorRequired]  public ApplicationUser user { get; set; } 
    [Parameter] public string? From { get; set; }


    private List<ApplicationRole> allRoles = new();

    // Items para CheckboxList (con icono opcional)
    private IEnumerable<RoleSelectedItem> RoleItems { get; set; } = Array.Empty<RoleSelectedItem>();

    // Roles seleccionados (nombres)
    private IEnumerable<string> SelectedRoleNames { get; set; } = Array.Empty<string>();

    private bool isLoading = true;
    private string? error;
    private string? success;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        error = success = null;

        
        if (user is null)
        {
            isLoading = false;
            return;
        }
        // no es necesario user, ya que se pada por parametro
        //user = await UserManager.FindByIdAsync(user.Id.ToString());

        await LoadRolesAsync();
        isLoading = false;
    }

    private async Task LoadRolesAsync()
    {
        //filtrar todos los roles para ese tenant
        allRoles = RoleManager.Roles
            .Where(r => r.TenantId == user!.TenantId)
            .OrderBy(r => r.Name)
            .ToList();

        var userRoles = await UserServiceMio.GetUserRolesAsync(user.Id); // IEnumerable<string>

        RoleItems = allRoles
            .Select(r =>
            {
                var roleName = r.Name!;
                var resourceKey = $"Role_{roleName}";

                // Texto localizado: UsuarioResources.Role_Admin, etc.
                var text = UsuarioResources.ResourceManager.GetString(resourceKey)
                           ?? roleName;

                var icon = roleName switch
                {
                    "Admin" => "fa-solid fa-user-shield",
                    "User" => "fa-solid fa-user",
                    "Manager" => "fa-solid fa-user-tie",
                    _ => "fa-regular fa-square-check"
                };

                return new RoleSelectedItem
                {
                    Text = text,
                    Value = roleName,
                    Icon = icon
                };
            })
            .ToList();

        SelectedRoleNames = userRoles.ToArray();
    }

    private async Task SaveRoles()
    {
        if (user is null)
        {
            error = "Usuario no encontrado.";
            return;
        }

        var selected = SelectedRoleNames.ToHashSet(StringComparer.OrdinalIgnoreCase);

        var result = await UserServiceMio.SetUserRolesAsync(user.Id, selected);

        if (result.Succeeded)
            success = "Roles actualizados.";
        else
            error = string.Join(" ", result.Errors.Select(e => e.Description));
    }


    public class RoleSelectedItem : SelectedItem
    {
        public string? Icon { get; set; }
    }
}
