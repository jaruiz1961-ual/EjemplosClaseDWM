@using BibliotecaContextosDb.TiposBase
@using BlazorSeguridad2026.Base.Genericos
@using BlazorSeguridad2026.Base.Modelo
@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity

@inject IContextProvider ContextProvider
@inject IUnitOfWorkFactory UnitOfWorkFactory
@inject UserManager<ApplicationUser> UserManager
@inject IUserService UserServiceMio
@inject NavigationManager Nav
@inject DialogService DialogService

@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Policy = Permissions.RolesEdit)]


<h3>Usuarios</h3>

@if (!_isValidContext)
{
    <div class="alert alert-warning">
        Contexto inválido. Selecciona Tenant y DbKey.
    </div>
}
else
{
    <Table TItem="ApplicationUser"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           IsStriped="true"
           IsBordered="true"
           IsMultipleSelect="false"
           ShowToolbar="true"
           ShowExtendButtons="true"
           ShowLoading="true"
           ShowSearch="true"
           OnAddAsync="OnAddAsync"
           OnEditAsync="OnEditAsync"
           OnSaveAsync="OnSaveAsync"
           OnDeleteAsync="OnDeleteAsync"
           OnQueryAsync="OnQueryAsync" ,
           ColumnButtonTemplateHeaderText="Acciones"
           IsExtendButtonsInRowHeader="false">

        <TableColumns>
            <TableColumn @bind-Field="context.Email" Text="Email" />
            <TableColumn @bind-Field="context.UserName" Text="Usuario" />
            <TableColumn @bind-Field="context.TenantId" Text="Tenant" />
            <TableColumn @bind-Field="context.DbKey" Text="DbKey" />
        </TableColumns>
        <!-- Botones DESPUÉS de los estándar -->

        
        <RowButtonTemplate Context="item">
            <AuthorizeView Policy="@Permissions.RolesEdit">
            <TableCellButton Color="Color.Warning"
                             Size="Size.Small"
                             OnClick="@(() => OpenRolesDialogAsync(item))"
                             class="ms-1">
                Roles
            </TableCellButton>
            </AuthorizeView>
        </RowButtonTemplate>
       
    </Table>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger mt-2">@error</div>
    }
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-success mt-2">@success</div>
    }
}

@code {


    private static IEnumerable<int> PageItemsSource => new[] { 4, 10, 20 };

    private List<ApplicationUser> Items { get; set; } = new();
    private bool _isValidContext;

    private string? error;
    private string? success;

    string fromUrl => Nav.ToBaseRelativePath(Nav.Uri);

    private Action? _onContextChangedHandler;

    static int TenantId;
    static string DbKey;

    bool CanEditUsers;

    protected override async Task OnInitializedAsync()
    {
        _onContextChangedHandler = async () => await LoadUsersAsync();
        ContextProvider.OnContextChanged += _onContextChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadUsersAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var result = await AuthorizationService.AuthorizeAsync(user, "Roles.Edit");
        CanEditUsers = result.Succeeded;
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            if (!ContextProvider.IsValidState(StorageKeys.ServerState))
            {
                _isValidContext = false;
                StateHasChanged();
                return;
            }

            await ContextProvider.ReadStates();
            var cp = ContextProvider.CopyContext();

            DbKey = cp.States[(int)StorageKeys.ServerState].DbKey ?? string.Empty;
            TenantId = cp.States[(int)StorageKeys.ServerState].TenantId ?? 0;

            // servicio recreado para lectura con el contexto actual
            var userServiceLectura = new UserServiceMio(UserManager, cp, UnitOfWorkFactory);
            var list = await userServiceLectura.GetAllAsync();

            Items = list?.ToList() ?? new();
            _isValidContext = true;
            StateHasChanged();
        }
        catch
        {
            _isValidContext = false;
            throw;
        }
    }

    // ------- CRUD del Table -------

    // ====== Apertura del modal de roles ======


    private async Task OpenRolesDialogAsync(ApplicationUser user)
    {
        var option = new DialogOption
        {
            Title = $"Asignar roles a {user.Email}",
            Size = Size.Large,
            IsScrolling = true,
            ShowCloseButton = true,

            // RenderFragment que inyecta tu componente dentro del diálogo
            BodyTemplate = builder =>
            {
                builder.OpenComponent(0, typeof(ComponenteUserRoles));
                builder.AddAttribute(1, "user", user);
                builder.AddAttribute(2, "From", Nav.Uri);

                builder.CloseComponent();
            }
        };

        await DialogService.Show(option);
        await Task.CompletedTask;
    }



    private static Task<ApplicationUser> OnAddAsync()
        => Task.FromResult(new ApplicationUser() {TenantId=TenantId, DbKey=DbKey});

    private static Task<ApplicationUser> OnEditAsync(ApplicationUser item)
        => Task.FromResult(item);

    private async Task<bool> OnSaveAsync(ApplicationUser item, ItemChangedType changedType)
    {
        error = success = null;

        if (changedType == ItemChangedType.Add)
        {
            if (string.IsNullOrWhiteSpace(item.Email))
            {
                error = "Email es obligatorio.";
                return false;
            }

            // aquí deberías pedir password de forma real (modal, form, etc.)
            var password = "P@ssw0rd!";

            var result = await UserServiceMio.CreateAsync(
                item.Email,
                password,
                item.TenantId,
                item.DbKey);

            if (!result.Succeeded)
            {
                error = string.Join(" ", result.Errors.Select(e => e.Description));
                return false;
            }
        }
        else
        {
            var result = await UserServiceMio.UpdateUserAsync(
                item.Id,
                u =>
                {
                    u.Email = item.Email;
                    u.UserName = item.UserName;
                    u.TenantId = item.TenantId;
                    u.DbKey = item.DbKey;
                });

            if (!result.Succeeded)
            {
                error = string.Join(" ", result.Errors.Select(e => e.Description));
                return false;
            }
        }

       
        success = "Usuario guardado.";
        await LoadUsersAsync();
        return true;
    }

    private async Task<bool> OnDeleteAsync(IEnumerable<ApplicationUser> items)
    {
        error = success = null;

        foreach (var u in items)
        {
            var result = await UserServiceMio.DeleteAsync(u.Id);
            if (!result.Succeeded)
            {
                error = string.Join(" ", result.Errors.Select(e => e.Description));
                return false;
            }
        }

       
        success = "Usuario(s) borrado(s).";
        await LoadUsersAsync();
        return true;
    }

    // ------- Data loading del Table -------

    private Task<QueryData<ApplicationUser>> OnQueryAsync(QueryPageOptions options)
    {
        IEnumerable<ApplicationUser> data = Items ?? new List<ApplicationUser>();

        var isSearch = false;

        if (!string.IsNullOrEmpty(options.SearchText))
        {
            var text = options.SearchText;
            data = data.Where(u =>
                (!string.IsNullOrEmpty(u.Email) && u.Email.Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(u.UserName) && u.UserName.Contains(text, StringComparison.OrdinalIgnoreCase)));
            isSearch = true;
        }

        var total = data.Count();

        data = data
            .Skip((options.PageIndex - 1) * options.PageItems)
            .Take(options.PageItems)
            .ToList();

        var result = new QueryData<ApplicationUser>
        {
            Items = data,
            TotalCount = total,
            IsSorted = false,
            IsFiltered = false,
            IsSearch = isSearch
        };

        return Task.FromResult(result);
    }
}
